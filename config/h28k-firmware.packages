luci-theme-design
luci-theme-fluent
wpad-openssl
openssh-sftp-server
wireless-regdb
kmod-mt7921u
kmod-rtl8812au-ct
kmod-rtl8821cu
kmod-rtl88x2bu
kmod-rtl8192cu
kmod-rtl8188eu
kmod-mt7601u
kmod-mt76x2u
rtl8192cu-firmware
rtl8821cu-firmware